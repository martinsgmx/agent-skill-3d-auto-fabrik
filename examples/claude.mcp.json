{
  "mcpServers": {
    "orca": {
      "command": "mcp-orca",
      "env": {
        "MCP_ORCA_CONFIG": "/path/to/mcp-orca.toml"
      }
    },
    "cura": {
      "command": "mcp-cura",
      "env": {
        "MCP_CURA_ENGINE_BINARY": "/usr/lib/cura/CuraEngine"
      }
    },
    "moonraker": {
      "command": "mcp-moonraker",
      "env": {
        "MOONRAKER_URL": "http://printer.local:7125"
      }
    }
  }
}
